  "item": [
    {
      "name": "Health & success",
      "item": [
        {
          "name": "GET /api/health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('ok is true', () => pm.expect(b.ok).to.be.true);",
                  "pm.test('uptime is a number', () => pm.expect(b.uptime).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Success - clean page (example.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('ok is true', () => pm.expect(b.ok).to.be.true);",
                  "pm.test('http status is 200', () => pm.expect(b.data.http.status).to.eql(200));",
                  "pm.test('has a title', () => pm.expect(b.data.content.title).to.be.a('string'));",
                  "pm.test('exactly one h1', () => pm.expect(b.data.content.h1Count).to.eql(1));",
                  "pm.test('not truncated', () => pm.expect(b.data.truncated).to.be.false);",
                  "pm.test('fetchedAt is a valid date', () => pm.expect(Date.parse(b.data.fetchedAt)).to.not.be.NaN);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
