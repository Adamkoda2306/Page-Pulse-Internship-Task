{
  "info": {
    "_postman_id": "76cda953-3975-437d-afdc-237f35c15f3f",
    "name": "Page Pulse API",
    "description": "Verifies every route and error branch of the Page Pulse audit API.\n\nSet the `baseUrl` collection variable to your deploy (default is the Render URL). Each request has a test that asserts the status code and error code, so 'Run collection' gives you a green/red pass over the whole contract in one shot.\n\nA few requests depend on httpbin.org being up (timeout, redirect-loop). If httpbin is down those two will fail through no fault of your code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "44863175",
    "_collection_link": "https://go.postman.co/collection/44863175-76cda953-3975-437d-afdc-237f35c15f3f?source=collection_link"
