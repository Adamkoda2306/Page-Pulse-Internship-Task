    {
      "name": "Rate limiting",
      "item": [
        {
          "name": "429 RATE_LIMITED - run this 21+ times",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Single request: passes with 200 until you cross the limit, then 429.",
                  "// To trigger it, open the Collection Runner, select ONLY this request,",
                  "// and set iterations to 25. The first 20 are 200, the rest are 429.",
                  "const code = pm.response.code;",
                  "pm.test('200 or 429', () => pm.expect([200, 429]).to.include(code));",
                  "if (code === 429) {",
                  "  pm.test('code is RATE_LIMITED', () => pm.expect(pm.response.json().error.code).to.eql('RATE_LIMITED'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\"\n}"
